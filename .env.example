# =============================================================================
# SAHABAT IBADAH - ENVIRONMENT VARIABLES CONTOH
# Salin file ini menjadi .env jika ingin menguji database Supabase secara lokal
# =============================================================================

# 1. Supabase PostgreSQL Connection String (Wajib diatur di Vercel Environment Variables)
# Didapat dari: Dashboard Supabase -> Project Settings -> Database -> Connection string -> URI
# Contoh (Transaction Pooler - Port 6543):
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require"
DATABASE_URL=

# 2. Kunci Rahasia JWT (Wajib diatur di Vercel Environment Variables)
# Gunakan kombinasi teks acak yang aman
JWT_SECRET=sahabat-ibadah-super-secret-key-2026

# 3. Port Server Lokal (Opsional, default: 5000)
PORT=5000
